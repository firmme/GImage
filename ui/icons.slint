import { Theme } from "theme.slint";

export component Icon inherits Path {
    in property <string> name;
    in property <color> tint: Theme.text-muted;
    in property <length> size: 18px;

    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: tint;
    stroke-width: 1.7px;
    commands: name == "grid" ? "M3 3 H10 V10 H3 Z M14 3 H21 V10 H14 Z M3 14 H10 V21 H3 Z M14 14 H21 V21 H14 Z"
        : name == "image" ? "M3 5 H21 V19 H3 Z M4 17 L9 11 L14 16 L17 13 L21 17 M15 8 H17"
        : name == "edit" ? "M4 20 L5 15 L16 4 L20 8 L9 19 Z M13 7 L17 11"
        : name == "tasks" ? "M12 3 A9 9 0 1 1 12 21 A9 9 0 1 1 12 3 M12 7 V12 L15.5 14"
        : name == "settings" ? "M10 3 H14 L15 6 L18 5 L20 8 L18 11 V13 L20 16 L18 19 L15 18 L14 21 H10 L9 18 L6 19 L4 16 L6 13 V11 L4 8 L6 5 L9 6 Z M15 12 A3 3 0 1 1 9 12 A3 3 0 1 1 15 12"
        : name == "folder" ? "M3 5 H10 L12 8 H21 V19 H3 Z"
        : name == "search" ? "M16 10 A6 6 0 1 1 4 10 A6 6 0 1 1 16 10 M14.5 14.5 L20 20"
        : name == "export" ? "M12 3 V15 M7 10 L12 15 L17 10 M4 16 V21 H20 V16"
        : name == "convert" ? "M4 7 H20 M16 3 L20 7 L16 11 M20 17 H4 M8 13 L4 17 L8 21"
        : name == "copy" ? "M8 8 H20 V21 H8 Z M16 8 V3 H3 V17 H8"
        : name == "link" ? "M9 14 L15 8 M10 6 L13 3 H18 L21 6 V11 L18 14 M6 10 L3 13 V18 L6 21 H11 L14 18"
        : name == "theme" ? "M20 14 A8 8 0 1 1 10 4 A6 6 0 0 0 20 14 Z"
        : name == "external" ? "M12 5 H5 V20 H20 V12 M13 4 H20 V11 M20 4 L11 13"
        : name == "rename" ? "M3 6 H9 M3 18 H9 M15 6 H21 M15 18 H21 M12 4 V20 M9 4 H15 M9 20 H15"
        : name == "refresh" ? "M20 10 A8 8 0 1 0 20 15 M20 4 V10 H14"
        : name == "star" ? "M12 3 L14.8 9 L21.5 10 L16.6 14.6 L17.8 21 L12 17.9 L6.2 21 L7.4 14.6 L2.5 10 L9.2 9 Z"
        : name == "asc" ? "M5 18 V5 M2 8 L5 5 L8 8 M11 6 H21 M11 12 H18 M11 18 H15"
        : name == "desc" ? "M5 5 V18 M2 15 L5 18 L8 15 M11 6 H21 M11 12 H18 M11 18 H15"
        : name == "back" ? "M20 12 H4 M11 5 L4 12 L11 19"
        : name == "previous" ? "M15 5 L8 12 L15 19"
        : name == "next" ? "M9 5 L16 12 L9 19"
        : name == "minus" || name == "minimize" ? "M5 12 H19"
        : name == "plus" ? "M5 12 H19 M12 5 V19"
        : name == "fit" ? "M9 4 H4 V9 M15 4 H20 V9 M20 15 V20 H15 M9 20 H4 V15"
        : name == "fullscreen" ? "M3 9 V3 H9 M15 3 H21 V9 M21 15 V21 H15 M9 21 H3 V15"
        : name == "fullscreen-exit" ? "M3 9 H9 V3 M15 3 V9 H21 M21 15 H15 V21 M9 21 V15 H3"
        : name == "menu" ? "M4 12 A1 1 0 1 0 6 12 A1 1 0 1 0 4 12 M11 12 A1 1 0 1 0 13 12 A1 1 0 1 0 11 12 M18 12 A1 1 0 1 0 20 12 A1 1 0 1 0 18 12"
        : name == "depth" ? "M4 4 H10 L12 7 H20 V11 H4 Z M8 14 V17 H14 M14 14 H20 V21 H14 Z"
        : name == "sidebar-left" ? "M3 5 H21 V19 H3 Z M9 5 V19 M5.5 9 H6.5 M5.5 12 H6.5"
        : name == "sidebar-right" ? "M3 5 H21 V19 H3 Z M15 5 V19 M17.5 9 H18.5 M17.5 12 H18.5"
        : name == "chevron-down" ? "M6 9 L12 15 L18 9"
        : name == "info" ? "M21 12 A9 9 0 1 1 3 12 A9 9 0 1 1 21 12 M12 7 V13 M12 15.5 V17"
        : name == "print" ? "M7 8 V3 H17 V8 M7 17 H3 V8 H21 V17 H17 M7 14 H17 V21 H7 Z M6 11 H8"
        : name == "save" ? "M4 3 H17 L21 7 V21 H4 Z M8 3 V9 H16 V3 M8 21 V13 H17 V21"
        : name == "undo" ? "M9 5 L4 10 L9 15 M4 10 H15 A5 5 0 0 1 15 20 H11"
        : name == "redo" ? "M15 5 L20 10 L15 15 M20 10 H9 A5 5 0 0 0 9 20 H13"
        : name == "rotate-left" ? "M9 3 L4 8 L9 13 M4 8 H14 A6 6 0 1 1 8 16"
        : name == "rotate-right" ? "M15 3 L20 8 L15 13 M20 8 H10 A6 6 0 1 0 16 16"
        : name == "flip-x" ? "M12 3 V21 M8.5 6 L3 18 H8.5 Z M15.5 6 L21 18 H15.5 Z"
        : name == "flip-y" ? "M3 12 H21 M6 8.5 L18 3 V8.5 Z M6 15.5 L18 21 V15.5 Z"
        : name == "crop" ? "M6 2 V18 H22 M2 6 H18 V22"
        : name == "check" ? "M4 12 L9 17 L20 6"
        : name == "trash" ? "M3 6 H21 M9 6 V3 H15 V6 M6 6 L7 21 H17 L18 6 M10 10 V17 M14 10 V17"
        : name == "help" ? "M21 12 A9 9 0 1 1 3 12 A9 9 0 1 1 21 12 M9 9 A3 3 0 1 1 14 11 L12 13 V14 M12 16 V18"
        : name == "warning" ? "M12 3 L22 20 H2 Z M12 9 V14 M12 16 V18"
        : name == "maximize" ? "M5 5 H19 V19 H5 Z"
        : name == "restore" ? "M4 8 H16 V20 H4 Z M8 8 V4 H20 V16 H16"
        : name == "pen" ? "M4 19 L5 15 L16 4 L20 8 L9 19 Z M13 7 L17 11 M3 22 H15"
        : name == "highlight" ? "M4 18 L6 14 L16 4 L21 9 L11 19 H4 Z M5 15 L9 19 M3 22 H19"
        : name == "line" ? "M4 20 L20 4"
        : name == "arrow" ? "M4 20 L20 4 M10 4 H20 V14"
        : name == "polygon" ? "M12 3 L21 9 L18 20 H6 L3 9 Z"
        : name == "mosaic" ? "M3 3 H21 V21 H3 Z M9 3 V21 M15 3 V21 M3 9 H21 M3 15 H21"
        : name == "text" ? "M4 5 H20 M12 5 V20 M8 20 H16"
        : name == "eraser" ? "M4 13 L13 4 L21 12 L13 20 H9 Z M7 10 L17 19 M13 20 H22"
        : name == "close" ? "M5 5 L19 19 M19 5 L5 19"
        : "M0 0";
}
