import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { App, TaskRow } from "state.slint";
import { AppButton, Badge, EmptyHint, HProgress } from "widgets.slint";

component TaskCard inherits Rectangle {
    in property <TaskRow> task;

    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;

    property <color> tint: task.state == 1
        ? Theme.accent
        : task.state == 2
            ? Theme.success
            : task.state == 3 || task.state == 6
                ? Theme.warning
                : task.state == 4
                    ? Theme.danger
                    : Theme.text-dim;

    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.task.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Badge { text: root.task.status; tint: root.tint; }
        }

        Text {
            text: root.task.detail;
            color: Theme.text-dim;
            font-size: 11px;
            overflow: elide;
        }

        if root.task.state != 6: HProgress {
            value: root.task.progress;
            tint: root.tint;
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.task.state == 6 ? "共 \{root.task.total} 项 · 进度未知" : "\{root.task.done} / \{root.task.total}";
                color: Theme.text-muted;
                font-size: 11px;
                vertical-alignment: center;
            }
            if root.task.failed > 0: Text {
                text: "\{root.task.failed} 项失败";
                color: Theme.danger;
                font-size: 11px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            if root.task.cancelable: AppButton {
                text: "取消";
                icon: "close";
                ghost: true;
                clicked => { App.task-cancel(root.task.id); }
            }
            if root.task.retryable: AppButton {
                text: "重试失败项";
                icon: "refresh";
                clicked => { App.task-retry(root.task.id); }
            }
        }
    }
}

export component TasksPage inherits Rectangle {
    background: Theme.bg;

    VerticalLayout {
        Rectangle {
            height: 56px;
            background: Theme.bg;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 11px;
                padding-bottom: 11px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: "任务";
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 600;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if App.active-tasks > 0: Badge {
                    text: "\{App.active-tasks} 个进行中";
                    tint: Theme.accent;
                }
                AppButton {
                    text: "清理已结束任务";
                    icon: "trash";
                    ghost: true;
                    clicked => { App.tasks-clear-finished(); }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border; }

        if App.tasks.length == 0: VerticalLayout {
            alignment: center;
            EmptyHint {
                icon: "tasks";
                title: "还没有任务";

            }
        }

        if App.tasks.length > 0: ScrollView {
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                for task in App.tasks: TaskCard { task: task; }
            }
        }
    }
}
