import { Theme } from "theme.slint";
export component SlimScrollbar inherits Rectangle {
    in property <length> content;
    in property <length> viewport;
    in property <length> offset;
    callback moved(length);

    width: 12px;
    visible: content > viewport + 1px;
    property <length> limit: max(1px, content - viewport);
    property <length> handle-height: min(self.height, max(24px, self.height * viewport / max(content, 1px)));
    property <length> travel: max(1px, self.height - handle-height);
    property <length> handle-y: clamp(offset / limit, 0, 1) * travel;
    property <length> grab: 0px;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.handle-y;
        width: track.has-hover || track.pressed ? 5px : 3px;
        height: root.handle-height;
        border-radius: 3px;
        background: track.has-hover || track.pressed ? Theme.text-dim : Theme.border-strong;
    }
    track := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.grab = self.mouse-y >= root.handle-y && self.mouse-y < root.handle-y + root.handle-height
                    ? self.mouse-y - root.handle-y : root.handle-height / 2;
                root.moved(clamp((self.mouse-y - root.grab) / root.travel, 0, 1) * root.limit);
            }
            if (event.kind == PointerEventKind.move && self.pressed) {
                root.moved(clamp((self.mouse-y - root.grab) / root.travel, 0, 1) * root.limit);
            }
        }
    }
}
import { Icon } from "icons.slint";
import { App } from "state.slint";

// ---------------------------------------------------------------------------
// Buttons
// ---------------------------------------------------------------------------
export component AppButton inherits Rectangle {
    in property <string> text;
    in property <string> icon: "";
    in property <string> tip: "";
    in property <bool> active: false;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> ghost: false;
    in property <bool> compact: false;
    in property <bool> enabled: true;
    callback clicked();

    height: Theme.control-h;
    horizontal-stretch: 0;
    min-width: 34px;
    border-radius: primary ? Theme.control-h / 2 : Theme.radius-sm;
    border-width: 1px;
    border-color: focus.has-focus && !root.mouse-focus ? Theme.focus : (primary ? transparent : (danger ? #e5484d55 : (ghost ? transparent : Theme.border)));
    background: primary
        ? (ta.pressed ? Theme.primary-hover : ta.has-hover ? Theme.primary-hover : Theme.primary)
        : danger
            ? (ta.pressed ? #7a2226 : ta.has-hover ? #58272a : Theme.surface)
            : (ta.pressed ? Theme.pressed : ta.has-hover ? Theme.hover : (root.active ? Theme.elevated : ghost ? transparent : Theme.surface));
    opacity: enabled ? 1.0 : 0.4;
    property <bool> mouse-focus: false;

    HorizontalLayout {
        padding-left: root.compact ? 7px : primary ? 14px : 12px;
        padding-right: root.compact ? 7px : primary ? 14px : 12px;
        spacing: root.compact ? 4px : 6px;
        alignment: center;
        if root.icon != "": Rectangle {
            width: 16px;
            Icon {
                name: root.icon;
                size: 16px;
                y: (parent.height - self.height) / 2;
                tint: root.primary ? Theme.on-primary : (root.active ? Theme.text : Theme.text-muted);
            }
        }
        Text {
            text: root.text;
            color: root.primary ? Theme.on-primary : (root.danger ? Theme.danger : (root.ghost && !root.active ? Theme.text-muted : Theme.text));
            font-size: root.compact ? 14px : 13px;
            font-weight: root.active || root.primary ? 600 : 400;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: focus;
    focus := FocusScope {
        enabled: root.enabled;
        changed has-focus => { if (!self.has-focus) { root.mouse-focus = false; } }
        key-pressed(event) => {
            root.mouse-focus = false;
            if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; }
            return reject;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.mouse-focus = true; focus.focus(); root.clicked(); }
    }
    Tooltip { text: @markdown("\{root.tip}"); }
}

export component HelpMark inherits Rectangle {
    in property <string> tip;
    width: 28px;
    Icon {
        name: "help";
        size: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    accessible-role: text;
    accessible-label: tip;
    Tooltip { text: @markdown("\{root.tip}"); }
}

export component IconButton inherits Rectangle {
    in property <string> icon: "";
    in property <string> glyph: "";
    in property <string> tip: "";
    in property <bool> active: false;
    in property <bool> checkable: false;
    in property <bool> enabled: true;
    in property <bool> close-button: false;
    in property <length> side: 32px;
    callback clicked();

    width: side;
    height: side;
    border-radius: Theme.radius-sm;
    border-width: focus.has-focus && !root.mouse-focus ? 1px : 0px;
    border-color: Theme.focus;
    background: root.close-button && ta.has-hover ? Theme.danger
        : ta.pressed ? Theme.pressed : ta.has-hover || root.active ? Theme.hover : transparent;
    opacity: enabled ? 1.0 : 0.38;
    property <bool> mouse-focus: false;

    if root.icon != "": Icon {
        name: root.icon;
        size: min(17px, root.side - 4px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        tint: root.close-button && ta.has-hover ? white : root.active ? Theme.text : Theme.text-muted;
    }
    if root.icon == "": Text {
        text: root.glyph;
        color: Theme.text-muted;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    accessible-role: button;
    accessible-label: tip != "" ? tip : glyph;
    accessible-enabled: enabled;
    accessible-checkable: checkable;
    accessible-checked: active;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: focus;
    focus := FocusScope {
        enabled: root.enabled;
        changed has-focus => { if (!self.has-focus) { root.mouse-focus = false; } }
        key-pressed(event) => {
            root.mouse-focus = false;
            if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; }
            return reject;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.mouse-focus = true; focus.focus(); root.clicked(); }
    }
    Tooltip { text: @markdown("\{root.tip}"); }
}

// ---------------------------------------------------------------------------
// Filter / segmented controls
// ---------------------------------------------------------------------------
export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> closable: false;
    callback clicked();
    callback close-clicked();

    height: 28px;
    border-radius: 14px;
    border-width: 1px;
    border-color: active ? Theme.border-strong : Theme.border;
    background: active ? Theme.elevated : (ta.has-hover ? Theme.hover : transparent);

    HorizontalLayout {
        padding-left: 11px;
        padding-right: root.closable ? 6px : 11px;
        spacing: 4px;
        alignment: center;
        Text {
            text: root.text;
            color: root.active ? Theme.text : Theme.text-muted;
            font-size: 12px;
            vertical-alignment: center;
        }
        if root.closable: Text {
            text: "✕";
            color: Theme.text-dim;
            font-size: 10px;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
}

export component Segmented inherits Rectangle {
    in-out property <[string]> options: [];
    in-out property <int> current: 0;
    in property <bool> emphasized-selection: false;
    callback changed(int);

    height: 30px;
    border-radius: 7px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for option[index] in options: Rectangle {
            border-radius: 5px;
            background: index == root.current ? (root.emphasized-selection ? Theme.primary : Theme.elevated)
                : ta.has-hover ? Theme.hover : transparent;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: center;
                Text {
                    text: option;
                    color: index == root.current ? (root.emphasized-selection ? Theme.on-primary : Theme.text) : Theme.text-dim;
                    font-weight: index == root.current ? 600 : 400;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.current = index;
                    root.changed(index);
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------
export component SearchBox inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "搜索文件名";
    callback edited(string);

    height: 32px;
    border-radius: 7px;
    background: Theme.surface;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;

    Icon {
        x: 10px;
        y: (parent.height - self.height) / 2;
        name: "search";
        size: 15px;
    }

    ContextMenuArea {
        Menu {
            MenuItem { title: "剪切"; activated => { input.cut(); } }
            MenuItem { title: "复制"; activated => { input.copy(); } }
            MenuItem { title: "粘贴"; activated => { input.paste(); } }
            MenuSeparator {}
            MenuItem { title: "全选"; activated => { input.select-all(); } }
        }
        input := TextInput {
            x: 28px;
            width: parent.width - 36px;
            height: parent.height;
            font-size: 13px;
            color: Theme.text;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.on-accent;
            vertical-alignment: center;
            single-line: true;
            edited => { root.edited(self.text); }
        }
    }
    if input.text == "" && !input.has-focus: Text {
        x: 28px;
        width: parent.width - 36px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.text-dim;
        font-size: 13px;
        vertical-alignment: center;
    }
}

export component TextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder: "";
    height: 32px;
    border-radius: 6px;
    background: Theme.bg;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;

    ContextMenuArea {
        Menu {
            MenuItem { title: "剪切"; activated => { input.cut(); } }
            MenuItem { title: "复制"; activated => { input.copy(); } }
            MenuItem { title: "粘贴"; activated => { input.paste(); } }
            MenuSeparator {}
            MenuItem { title: "全选"; activated => { input.select-all(); } }
        }
        input := TextInput {
            x: 10px;
            width: parent.width - 20px;
            height: parent.height;
            font-size: 13px;
            color: Theme.text;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.on-accent;
            vertical-alignment: center;
            single-line: true;
        }
    }
    if text == "" && !input.has-focus: Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.text-dim;
        font-size: 12px;
        vertical-alignment: center;
    }
}

export component AppSlider inherits Rectangle {
    /// Actual value, not normalised. Bind two-way (`value <=> App.exposure`) so
    /// that dragging and programmatic updates share one source of truth.
    in-out property <float> value: 0;
    in property <float> min-value: 0;
    in property <float> max-value: 1;
    in property <bool> enabled: true;
    callback changed(float);
    callback reset();

    height: 26px;
    property <float> norm: root.max-value > root.min-value ? min(max((root.value - root.min-value) / (root.max-value - root.min-value), 0.0), 1.0) : 0;

    track := Rectangle {
        x: 0;
        y: (parent.height - 4px) / 2;
        width: parent.width;
        height: 4px;
        border-radius: 2px;
        background: Theme.hover;
    }
    Rectangle {
        x: 0;
        y: track.y;
        width: parent.width * root.norm;
        height: 4px;
        border-radius: 2px;
        background: root.enabled ? Theme.accent : Theme.border;
    }
    Rectangle {
        x: min(max(parent.width * root.norm - 7px, 0px), parent.width - 14px);
        y: (parent.height - 14px) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: #ffffff;
        border-width: 1px;
        border-color: #00000040;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        moved => { root.set-from-x(self.mouse-x); }
        pointer-event(pe) => {
            if (pe.kind == PointerEventKind.down) {
                root.set-from-x(self.mouse-x);
            }
        }
        double-clicked => { root.reset(); }
    }

    function set-from-x(x: length) {
        if (root.width <= 0px || root.max-value <= root.min-value) { return; }
        let v = root.min-value + min(max(x / root.width, 0.0), 1.0) * (root.max-value - root.min-value);
        if (v != root.value) {
            root.value = v;
            root.changed(v);
        }
    }
}

export component FloatSlider inherits VerticalLayout {
    in property <string> label;
    in property <string> display;
    in-out property <float> value: 0;
    in property <float> min-value: -1;
    in property <float> max-value: 1;
    callback changed(float);
    callback reset();
    spacing: 2px;
    HorizontalLayout {
        Text {
            text: root.label;
            color: Theme.text-muted;
            font-size: 12px;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: root.display;
            color: Theme.text-dim;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    AppSlider {
        value <=> root.value;
        min-value: root.min-value;
        max-value: root.max-value;
        changed(v) => { root.changed(v); }
        reset => { root.reset(); }
    }
}

export component Stepper inherits Rectangle {
    in-out property <int> value: 1;
    in property <int> min-value: 1;
    in property <int> max-value: 999;
    in property <int> step: 1;
    in property <bool> enabled: true;
    callback changed(int);

    height: 30px;
    border-radius: 7px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    opacity: enabled ? 1.0 : 0.45;

    HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;
        spacing: 2px;
        alignment: center;
        IconButton {
            icon: "minus";
            tip: "减小";
            side: 24px;
            enabled: root.enabled && root.value > root.min-value;
            clicked => {
                root.value = max(root.min-value, root.value - root.step);
                root.changed(root.value);
            }
        }
        Text {
            text: "\{root.value}";
            color: Theme.text;
            font-size: 13px;
            min-width: 38px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        IconButton {
            icon: "plus";
            tip: "增大";
            side: 24px;
            enabled: root.enabled && root.value < root.max-value;
            clicked => {
                root.value = min(root.max-value, root.value + root.step);
                root.changed(root.value);
            }
        }
    }
}

export component AppToggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? Theme.accent : Theme.hover;
    opacity: root.enabled ? 1.0 : 0.4;

    Rectangle {
        x: root.checked ? parent.width - 18px : 2px;
        y: 2px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: #ffffff;
        animate x { duration: Theme.low-power ? 0ms : 120ms; easing: ease-out; }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// ---------------------------------------------------------------------------
// Small building blocks
// ---------------------------------------------------------------------------
export component SectionTitle inherits Text {
    color: Theme.text-muted;
    font-size: 12px;
    font-weight: 600;
    vertical-alignment: center;
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

export component MetaRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 24px;

    HorizontalLayout {
        spacing: 10px;
        Text {
            text: root.label;
            width: 60px;
            color: Theme.text-muted;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle {
            min-width: 0px;
            horizontal-stretch: 1;
            clip: true;
            Text {
                width: parent.width;
                height: parent.height;
                text: root.value;
                color: Theme.text;
                font-size: 13px;
                overflow: elide;
                vertical-alignment: center;
            }
            Tooltip { text: @markdown("\{root.value}"); }
            ContextMenuArea {
                Menu {
                    MenuItem { title: "复制"; activated => { App.copy-text(root.value); } }
                }
            }
        }
    }
}

export component HProgress inherits Rectangle {
    in property <float> value: 0;
    in property <color> tint: Theme.accent;
    height: 4px;
    border-radius: 2px;
    background: Theme.hover;
    Rectangle {
        width: parent.width * min(max(root.value, 0), 1);
        height: parent.height;
        border-radius: 2px;
        background: root.tint;
    }
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.text-muted;
    height: 20px;
    border-radius: 4px;
    background: Theme.surface-alt;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.text;
            color: root.tint;
            font-size: 10px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component EmptyHint inherits VerticalLayout {
    in property <string> icon: "image";
    in property <string> title;
    in property <string> body: "";
    spacing: 8px;
    alignment: center;
    Rectangle {
        height: 32px;
        Icon {
            name: root.icon;
            size: 30px;
            x: (parent.width - self.width) / 2;
        }
    }
    Text {
        text: root.title;
        color: Theme.text;
        font-size: 15px;
        font-weight: 600;
        horizontal-alignment: center;
    }
    if root.body != "": Text {
        text: root.body;
        color: Theme.text-muted;
        font-size: 12px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}
